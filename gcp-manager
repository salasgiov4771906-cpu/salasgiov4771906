#!/bin/bash

set -e

PROJECT=$(gcloud config get-value project 2>/dev/null)

if [ -z "$PROJECT" ]; then
    echo "❌ Chưa chọn project"
    echo "gcloud config set project PROJECT_ID"
    exit 1
fi

echo "Project: $PROJECT"
echo

echo "🌏 Chọn khu vực:"
echo "1) Tokyo (asia-northeast1)"
echo "2) Osaka (asia-northeast2)"

read -p "Nhập [1-2] (ENTER = Random): " REGION_CHOICE

if [ -z "$REGION_CHOICE" ]; then
    if (( RANDOM % 2 )); then
        REGION="asia-northeast1"
        PREFIX_DEFAULT="tokyo"
    else
        REGION="asia-northeast2"
        PREFIX_DEFAULT="osaka"
    fi
elif [ "$REGION_CHOICE" = "1" ]; then
    REGION="asia-northeast1"
    PREFIX_DEFAULT="tokyo"
else
    REGION="asia-northeast2"
    PREFIX_DEFAULT="osaka"
fi

echo
echo "📍 Chọn zone"

if [ "$REGION" = "asia-northeast1" ]; then
    echo "1) asia-northeast1-a"
    echo "2) asia-northeast1-b"
    echo "3) asia-northeast1-c"

    read -p "ENTER = Random: " Z

    case "$Z" in
        1) ZONE="asia-northeast1-a" ;;
        2) ZONE="asia-northeast1-b" ;;
        3) ZONE="asia-northeast1-c" ;;
        *)
            ARR=("asia-northeast1-a" "asia-northeast1-b" "asia-northeast1-c")
            ZONE=${ARR[$RANDOM % ${#ARR[@]}]}
            ;;
    esac
else
    echo "1) asia-northeast2-a"
    echo "2) asia-northeast2-b"
    echo "3) asia-northeast2-c"

    read -p "ENTER = Random: " Z

    case "$Z" in
        1) ZONE="asia-northeast2-a" ;;
        2) ZONE="asia-northeast2-b" ;;
        3) ZONE="asia-northeast2-c" ;;
        *)
            ARR=("asia-northeast2-a" "asia-northeast2-b" "asia-northeast2-c")
            ZONE=${ARR[$RANDOM % ${#ARR[@]}]}
            ;;
    esac
fi

echo
read -p "📝 Prefix VM (ENTER = $PREFIX_DEFAULT): " PREFIX
PREFIX=${PREFIX:-$PREFIX_DEFAULT}

echo
read -p "🔢 Số lượng VM (ENTER = 5): " VM_COUNT
VM_COUNT=${VM_COUNT:-5}

echo
echo "🌐 Public IP"
echo "1) Có Public IP"
echo "2) Private Only"

read -p "ENTER = 1: " PUBLIC_IP
PUBLIC_IP=${PUBLIC_IP:-1}

echo
echo "🚀 Network Tier"
echo "1) STANDARD"
echo "2) PREMIUM"

read -p "ENTER = 1: " TIER
TIER=${TIER:-1}

if [ "$TIER" = "2" ]; then
    NETWORK_TIER="PREMIUM"
else
    NETWORK_TIER="STANDARD"
fi

echo
echo "===================================="
echo "Region      : $REGION"
echo "Zone        : $ZONE"
echo "Prefix      : $PREFIX"
echo "VM Count    : $VM_COUNT"
echo "Public IP   : $PUBLIC_IP"
echo "Tier        : $NETWORK_TIER"
echo "===================================="

echo
echo "🚀 Bắt đầu tạo VM..."
sleep 1

for ((i=1;i<=VM_COUNT;i++))
do
    RND=$((100 + RANDOM % 900))
    VM_NAME="${PREFIX}-${RND}"

    echo "➡️ Tạo $VM_NAME"

    if [ "$PUBLIC_IP" = "2" ]; then

        gcloud compute instances create "$VM_NAME" \
            --zone="$ZONE" \
            --machine-type=e2-micro \
            --image-family=ubuntu-2204-lts \
            --image-project=ubuntu-os-cloud \
            --no-address

    else

        gcloud compute instances create "$VM_NAME" \
            --zone="$ZONE" \
            --machine-type=e2-micro \
            --image-family=ubuntu-2204-lts \
            --image-project=ubuntu-os-cloud \
            --network-tier="$NETWORK_TIER"

    fi
done

echo
echo "✅ VM vừa tạo:"
echo

for vm in "${CREATED_VMS[@]}"
do
    IP=$(gcloud compute instances describe "$vm" \
        --zone="$ZONE" \
        --format="value(networkInterfaces[0].accessConfigs[0].natIP)")

    echo "$vm | $IP"
done

