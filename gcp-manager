#!/bin/bash

create_multiple_vm() {

```
clear
echo "=============================="
echo "      CREATE MULTIPLE VM"
echo "=============================="

echo ""
echo "🖥️ Chọn loại máy:"
echo "1) e2-micro (mặc định)"
echo "2) e2-small"
echo "3) e2-medium"

read -p "👉 Lựa chọn [1-3] (Enter=1): " TYPE
TYPE=${TYPE:-1}

case $TYPE in
    1) MACHINE_TYPE="e2-micro" ;;
    2) MACHINE_TYPE="e2-small" ;;
    3) MACHINE_TYPE="e2-medium" ;;
    *) MACHINE_TYPE="e2-micro" ;;
esac

echo ""
echo "🌏 Chọn khu vực:"
echo "1) Tokyo"
echo "2) Osaka"

read -p "👉 Lựa chọn [1-2] (Enter=1): " REGION
REGION=${REGION:-1}

if [[ "$REGION" == "1" ]]; then
    REGION_NAME="asia-northeast1"
    DEFAULT_PREFIX="tokyo"
    ZONES=("asia-northeast1-a" "asia-northeast1-b" "asia-northeast1-c")
else
    REGION_NAME="asia-northeast2"
    DEFAULT_PREFIX="osaka"
    ZONES=("asia-northeast2-a" "asia-northeast2-b" "asia-northeast2-c")
fi

echo ""
echo "📍 Chọn Zone:"
echo "1) ${ZONES[0]}"
echo "2) ${ZONES[1]}"
echo "3) ${ZONES[2]}"
echo "Enter = Random"

read -p "👉 Zone: " ZONE_CHOICE

echo ""
read -p "📝 Prefix VM (Enter=${DEFAULT_PREFIX}): " PREFIX
PREFIX=${PREFIX:-$DEFAULT_PREFIX}

read -p "🔢 Số lượng VM (Enter=5): " VM_COUNT
VM_COUNT=${VM_COUNT:-5}

echo ""
echo "🌐 Public IP?"
echo "1) Có"
echo "2) Không"

read -p "👉 Lựa chọn (Enter=1): " PUBLIC_IP
PUBLIC_IP=${PUBLIC_IP:-1}

echo ""
echo "📡 Network Tier"
echo "1) STANDARD"
echo "2) PREMIUM"

read -p "👉 Lựa chọn (Enter=1): " TIER
TIER=${TIER:-1}

if [[ "$TIER" == "1" ]]; then
    NETWORK_TIER="STANDARD"
else
    NETWORK_TIER="PREMIUM"
fi

echo ""
echo "🚀 Bắt đầu tạo VM..."
echo ""

for ((i=1;i<=VM_COUNT;i++))
do

    VM_NAME=$(printf "%s%02d" "$PREFIX" "$i")

    if [[ -z "$ZONE_CHOICE" ]]; then
        INDEX=$((RANDOM % 3))
        ZONE=${ZONES[$INDEX]}
    else
        case $ZONE_CHOICE in
            1) ZONE=${ZONES[0]} ;;
            2) ZONE=${ZONES[1]} ;;
            3) ZONE=${ZONES[2]} ;;
            *) ZONE=${ZONES[0]} ;;
        esac
    fi

    echo "📦 Tạo $VM_NAME tại $ZONE"

    if [[ "$PUBLIC_IP" == "1" ]]; then

        gcloud compute instances create "$VM_NAME" \
        --zone="$ZONE" \
        --machine-type="$MACHINE_TYPE" \
        --image-family=ubuntu-2404-lts-amd64 \
        --image-project=ubuntu-os-cloud \
        --network-tier="$NETWORK_TIER"

    else

        gcloud compute instances create "$VM_NAME" \
        --zone="$ZONE" \
        --machine-type="$MACHINE_TYPE" \
        --image-family=ubuntu-2404-lts-amd64 \
        --image-project=ubuntu-os-cloud \
        --no-address

    fi

done

echo ""
echo "✅ Hoàn tất!"
```

}

