#!/bin/bash

set -e

SOCKS_PORT="7001"
HTTP_PORT="6001"

USERNAME=$(openssl rand -hex 4)
PASSWORD=$(openssl rand -hex 4)

echo "================================"
echo " Install SOCKS5 + HTTP Proxy"
echo "================================"

apt update
apt install -y dante-server squid apache2-utils curl openssl

IFACE=$(ip route | awk '/default/ {print $5}' | head -1)

echo "Network Interface: $IFACE"

#################################

# USER

#################################

id "$USERNAME" >/dev/null 2>&1 || useradd -m "$USERNAME"
echo "${USERNAME}:${PASSWORD}" | chpasswd

#################################

# DANTE SOCKS5

#################################

cat >/etc/danted.conf <<EOF
logoutput: syslog

internal: 0.0.0.0 port = ${SOCKS_PORT}
external: ${IFACE}

socksmethod: username

user.privileged: root
user.unprivileged: nobody

client pass {
from: 0.0.0.0/0 to: 0.0.0.0/0
}

socks pass {
from: 0.0.0.0/0 to: 0.0.0.0/0
protocol: tcp udp
}
EOF

systemctl enable danted
systemctl restart danted

#################################

# SQUID HTTP

#################################

htpasswd -bc /etc/squid/passwd "$USERNAME" "$PASSWORD"

cat >/etc/squid/squid.conf <<EOF
auth_param basic program /usr/lib/squid/basic_ncsa_auth /etc/squid/passwd
auth_param basic realm proxy

acl authenticated proxy_auth REQUIRED

http_access allow authenticated
http_access deny all

http_port ${HTTP_PORT}
EOF

systemctl enable squid
systemctl restart squid

#################################

# OUTPUT

#################################

PUBLIC_IP=$(curl -4 -s ifconfig.me)

echo
echo "================================"
echo " Proxy Ready"
echo "================================"
echo

echo "socks5:${PUBLIC_IP}:${SOCKS_PORT}:${USERNAME}:${PASSWORD}&http:${PUBLIC_IP}:${HTTP_PORT}:${USERNAME}:${PASSWORD}"
echo
echo "Nhớ mở Firewall GCP:"
echo "tcp:${SOCKS_PORT}"
echo "tcp:${HTTP_PORT}"
